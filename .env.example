# Airtable personal access token (scopes: data.records:read, data.records:write)
AIRTABLE_TOKEN=your_airtable_token_here

# Secret shared between Airtable automation and this function
WEBHOOK_SECRET=your_secret_here

# Payday API (api/payday.js) — OAuth client credentials from
# Payday → Stillingar → Fyrirtæki (create an API application there).
# The proxy exchanges these for a 24h bearer token server-side.
# PAYDAY_PROXY_SECRET is a secret you invent; callers must send it as the
# X-Payday-Key header. If unset, api/payday.js is disabled (503).
PAYDAY_CLIENT_ID=your_payday_client_id_here
PAYDAY_CLIENT_SECRET=your_payday_client_secret_here
PAYDAY_PROXY_SECRET=invent_a_long_random_string

# Anthropic API key — used by api/chat.js (site chatbot widget). Same
# account already used for Claude vision extraction in bjorninn-skipulag;
# get one from console.anthropic.com if a fresh one is needed.
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional — overrides the default model (claude-haiku-4-5-20251001) used
# for chat replies.
# CHATBOT_MODEL=claude-haiku-4-5-20251001

# Landsbankinn "AIRTABLE" system access (Netbanki fyrirtækja) — used by
# api/bank-sync.js for the mTLS client_credentials auth flow.
# LB_API_KEY is the apikey/client_id shown in "Sýna API-lykil".
# LB_CERT_P12_BASE64 is the .p12 certificate file, base64-encoded:
#   base64 -i CertificateFileName.p12 | tr -d '\n'
LB_API_KEY=your_landsbankinn_apikey_here
LB_CERT_P12_BASE64=base64_of_your_p12_file_here
LB_CERT_PASSWORD=your_certificate_password_here
